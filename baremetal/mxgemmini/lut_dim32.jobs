# The DIM=32 MX LUT-format requant tests (32x32 mesh), in bisection order (cheapest first). These live
# in the bareMetalC ISA suite (software/gemmini-rocc-tests/bareMetalC); simq resolves the names against
# build_mx_rocket/bareMetalC/<name>-baremetal. Feed it to simq:
#
#   tools/simq run CONFIG=MxDim32AllGemminiRocketConfig BINARY=baremetal/mxgemmini/lut_dim32.jobs JOBS=8
#
# IMPORTANT: run under CONFIG=MxDim32AllGemminiRocketConfig (the 32x32 all-format LUT mesh), NOT the
# DIM=16 MxGemminiRocketConfig that ladder.jobs uses -- these tests hardcode DIM=32 and need the 32x32 simv.
#
# Build the ELFs first:  cd ../../software/gemmini-rocc-tests && ./build_mx_rocket.sh bareMetalC
# Spike cross-check (bit-exact with RTL; all rungs PASS on spike as of 2026-09-21):
#   spike --extension=gemmini_dim32 build_spike/bareMetalC/<name>-baremetal
# Goldens come from gen_mx_lut.py (DIM-aware, Spike-consistent). The 32x32 LUT deproject needed the
# QuantLut.scala DIM-general fix (see planning/mxgemmini_rocket_standalone_plan.md).
#
# The 4 LUT formats: E4M3-quad (fp8/altfmt0), E5M2 (fp8/altfmt1), E2M3 (fp6/altfmt1), E3M2 (fp6/altfmt0).

# --- 64x64  (control: I=1 J=1 Kt=2, one super-block) ---
matmul_tiled_fp8_e4m3_lut_64x64_requant_dim32
matmul_tiled_fp8_e5m2_64x64_requant_dim32
matmul_tiled_fp6_e2m3_lut_64x64_requant_dim32
matmul_tiled_fp6_e3m2_lut_64x64_requant_dim32

# --- 128x128  (I=2 J=2 Kt=4: multi I/J tile + the 2nd super-block per j-group) ---
matmul_tiled_fp8_e4m3_lut_128x128_requant_dim32
matmul_tiled_fp8_e5m2_128x128_requant_dim32
matmul_tiled_fp6_e2m3_lut_128x128_requant_dim32
matmul_tiled_fp6_e3m2_lut_128x128_requant_dim32

# --- 128x64x128  (M>N: I=2 J=1 Kt=4) ---
matmul_tiled_fp8_e4m3_lut_128x64x128_requant_dim32
matmul_tiled_fp8_e5m2_128x64x128_requant_dim32
matmul_tiled_fp6_e2m3_lut_128x64x128_requant_dim32
matmul_tiled_fp6_e3m2_lut_128x64x128_requant_dim32

# --- 64x128x128  (N>M: I=1 J=2 Kt=4) ---
matmul_tiled_fp8_e4m3_lut_64x128x128_requant_dim32
matmul_tiled_fp8_e5m2_64x128x128_requant_dim32
matmul_tiled_fp6_e2m3_lut_64x128x128_requant_dim32
matmul_tiled_fp6_e3m2_lut_64x128x128_requant_dim32
