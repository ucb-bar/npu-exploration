#   tools/simq run CONFIG=MxAllAsymGemminiRocketConfig BINARY=baremetal/mxgemmini/regress_bf16_drain_dim16_asym.jobs JOBS=8
#
# A FAIL: rerun that test on the pre-revert RTL before blaming the revert.
